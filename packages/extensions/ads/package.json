{
  "name": "@videojs/ads",
  "version": "10.1.0",
  "private": true,
  "description": "Optional JSON advertising schedules for Video.js",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/*/html/define.js",
    "./dist/cdn/ads.js"
  ],
  "main": "dist/default/index.js",
  "module": "dist/default/index.js",
  "types": "dist/dev/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/default/index.js"
    },
    "./dom": {
      "types": "./dist/dev/dom/index.d.ts",
      "development": "./dist/dev/dom/index.js",
      "default": "./dist/default/dom/index.js"
    },
    "./html": {
      "types": "./dist/dev/html/index.d.ts",
      "development": "./dist/dev/html/index.js",
      "default": "./dist/default/html/index.js"
    },
    "./define": {
      "types": "./dist/dev/html/define.d.ts",
      "development": "./dist/dev/html/define.js",
      "default": "./dist/default/html/define.js"
    },
    "./cdn/ads.js": "./dist/cdn/ads.js"
  },
  "scripts": {
    "dev": "vp pack --watch ./src --no-clean",
    "test": "vp test run",
    "test:watch": "vp test",
    "clean": "rimraf --glob dist types '*.tsbuildinfo'"
  },
  "dependencies": {
    "@videojs/core": "workspace:*",
    "@videojs/element": "workspace:*",
    "@videojs/html": "workspace:*",
    "@videojs/icons": "workspace:*",
    "@videojs/utils": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vite-plus": "catalog:"
  }
}
